rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is the document owner by user_id field
    function isDocumentOwner(userIdField) {
      return isAuthenticated() && request.auth.uid == resource.data[userIdField];
    }
    
    // Helper function to check if user is the document owner by userId field
    function isDocumentOwnerByUserId(userIdField) {
      return isAuthenticated() && request.auth.uid == resource.data[userIdField];
    }

    // Happy moments - anyone logged in can read them (to see Pod feeds), but only the author can edit/delete them
    match /happy_moments/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        (resource == null || request.auth.uid == resource.data.userId);
    }

    // Journal entries - users can only access their own
    match /journal_entries/{document} {
      allow read, write: if isAuthenticated() && 
        (resource == null || request.auth.uid == resource.data.user_id);
    }
    
    // Encouragements - users can only access their own
    match /encouragements/{document} {
      allow read, write: if isAuthenticated() && 
        (resource == null || request.auth.uid == resource.data.user_id);
    }
    
    // Groups - authenticated users can read/write
    match /groups/{document} {
      allow read, write: if isAuthenticated();
    }
    
    // Group members - authenticated users can read/write
    match /group_members/{document} {
      allow read, write: if isAuthenticated();
    }
    
// User profiles - anyone logged in can search profiles
    match /user_profiles/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        (document == request.auth.uid || resource == null);
    }
    
    // Users collection (for username search) - anyone logged in can search
    match /users/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        (document == request.auth.uid || resource == null);
    }
        
    // Friend requests - users can read their own requests, write new ones
    match /friend_requests/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.fromUserId;
      allow update: if isAuthenticated();
    }

    // Notifications - users can only access their own
    match /notifications/{document} {
      allow read, write: if isAuthenticated() && 
        (resource == null || request.auth.uid == resource.data.user_id);
    }
    
    // Messages - users can only access their own
    match /messages/{document} {
      allow read, write: if isAuthenticated() && 
        (resource == null || 
         request.auth.uid == resource.data.sender_id || 
         request.auth.uid == resource.data.recipient_id);
    }
    
    // Daily prompt responses - users can only access their own, but can read public ones
    match /daily_prompt_responses/{document} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      allow write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // Daily prompts - anyone authenticated can read
    match /daily_prompts/{document} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admin can create prompts
    }
    
    // Posts - users can read public posts, write their own
    match /posts/{document} {
      allow read: if isAuthenticated() && 
        (resource.data.isPublic == true || resource.data.userId == request.auth.uid);
      allow write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // Invites - users can read invites sent to them, write their own
    match /invites/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.fromUserId;
      allow update: if isAuthenticated();
    }

    // Social shares - users can read their own shares, write their own
    match /social_shares/{document} {
      allow read, write: if isAuthenticated() && 
        (resource == null || request.auth.uid == resource.data.userId);
    }
    
    match /user_stats/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}